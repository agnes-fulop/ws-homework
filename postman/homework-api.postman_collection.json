{
  "info": {
    "name": "Homework API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "Register sensor (full metadata)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sensors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"SN-001\",\n  \"country\": \"Hungary\",\n  \"city\": \"Budapest\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register sensor (id only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sensors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"SN-002\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Readings",
      "item": [
        {
          "name": "Record a reading",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sensors/SN-001/readings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metric\": \"temperature\",\n  \"value\": 23.5\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Query averages — specific sensors and date range",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/readings/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorIds\": [\"SN-001\", \"SN-002\"],\n  \"metrics\": [\"temperature\", \"humidity\"],\n  \"from\": \"2025-04-24\",\n  \"to\": \"2025-05-01\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Query averages — all sensors, last 24 h (no date range)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/readings/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metrics\": [\"temperature\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}
